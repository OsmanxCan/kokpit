# Kokpit başlangıç ayarları — /etc/kokpit/config.env
#
# NOT: Telegram, eşikler, izlenen servisler, oturum ve güncelleme ayarları artık
# panelden (Ayarlar sayfası) yönetiliyor. Buradaki değerler sadece İLK açılışta
# kullanılır; sonrasında panelden yapılan ayarlar geçerlidir (/var/lib/kokpit/settings.json).
# Değişiklikten sonra: systemctl restart kokpit

# Panel SADECE localhost'ta dinlemeli. Dışarıdan erişim Cloudflare Tunnel ile.
PANEL_ADDR=127.0.0.1:3100
PANEL_DATA=/var/lib/kokpit

# Oturumu giriş yapılan IP'ye bağla (mobil veride IP değişirse yeniden giriş ister)
PANEL_SESSION_IP_BIND=true

# PM2 (nvm ile kurulu pm2 otomatik bulunur; bulunamazsa yolu yaz)
# PANEL_PM2_BIN=/root/.nvm/versions/node/v22.0.0/bin/pm2
PM2_HOME=/root/.pm2

# Çökerse bildirim gönderilecek systemd servisleri (virgülle)
# (sunucuda olmayanlar yok sayılır; örn. openvpn-server@server, wg-quick@wg0 ekleyebilirsin)
PANEL_WATCH_SERVICES=nginx,ssh,docker,cloudflared,fail2ban,pm2-root

# Telegram bildirimleri (REHBER.md → "Telegram botu")
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Güncelleme kontrolü (GitHub Releases, 6 saatte bir)
PANEL_UPDATE_CHECK=true
# Kendi fork'unu kullanıyorsan: PANEL_REPO=kullanici/depo
# PANEL_REPO=

# Uyarı eşikleri (yüzde)
ALERT_CPU=90
ALERT_RAM=90
ALERT_DISK=90
